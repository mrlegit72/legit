# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Telegram (my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=osint_session

# Telegram alert bot (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Polymarket
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
# Only required for live trading
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=

# Risk/execution
TRADE_MODE=dry_run            # dry_run | paper | live
BANKROLL_USDC=500
MAX_POSITION_PCT=0.05         # max 5% of bankroll per trade
MIN_EDGE=0.05                 # require >=5% edge before trading
MIN_CONFIDENCE=80             # 0-100, drop signals below this
KELLY_FRACTION=0.25           # fractional Kelly for safety
DAILY_LOSS_LIMIT_PCT=0.15     # halt trading after -15% day

# Storage
DATABASE_URL=sqlite+aiosqlite:///./osint_trader.db
LOG_LEVEL=INFO
