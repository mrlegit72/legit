# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Claude (Anthropic) — used by the Editor step.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# X (Twitter) Free Tier OAuth 1.0a user-context credentials.
# Required to POST tweets via tweepy.Client.create_tweet.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Optional knobs
CURATOR_DB_PATH=curator_state.sqlite3
CURATOR_MAX_POSTS=3
CURATOR_DRY_RUN=false
